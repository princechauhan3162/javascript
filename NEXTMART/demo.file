* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  font-family: Arial, Helvetica, sans-serif;
}

body {
  background: #f5f5f5;
}

.top-header {
  width: 100%;
  background: #0d47a1;
  color: white;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20px 40px;
  flex-wrap: wrap;
}

.logo {
  display: flex;
  align-items: center;
}

.logo img {
  width: 200px;
  margin-right: 150px;
}

.logo h2 {
  font-size: 40px;
}

.search-box {
  display: flex;
  background: white;
  border-radius: 40px;
  overflow: hidden;
  width: 650px;
}

.search-box select {
  width: 220px;
  border: none;
  outline: none;
  padding: 15px;
}

.search-box input {
  flex: 1;
  border: none;
  outline: none;
  padding: 15px;
}

.search-box button {
  width: 70px;
  border: none;
  background: orange;
  color: white;
  font-size: 22px;
  cursor: pointer;
}

.right-side {
  display: flex;
  align-items: center;
  gap: 40px;
}

.hotline {
  display: flex;
  align-items: center;
}

.hotline i {
  font-size: 35px;
  margin-right: 10px;
}

.hotline h3 {
  font-size: 28px;
}

.hotline p {
  font-size: 14px;
}

.navbar {
  background: white;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18px 40px;
  box-shadow: 0 2px 10px lightgray;
  flex-wrap: wrap;
}

.menu-btn {
  border: 1px solid #ddd;
  padding: 15px 20px;
  cursor: pointer;
  width: 250px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 20px;
}

.navbar ul {
  display: flex;
  list-style: none;
}

.navbar ul li {
  margin: 0 20px;
}

.navbar ul li a {
  text-decoration: none;
  color: black;
  font-size: 20px;
}

.navbar ul li a:hover {
  color: #0d47a1;
}

.nav-icons {
  display: flex;
  align-items: center;
  gap: 25px;
}

.nav-icons select {
  border: none;
  font-size: 18px;
}

.nav-icons i {
  font-size: 25px;
  cursor: pointer;
}

.cart {
  position: relative;
}

.cart span {
  position: absolute;
  top: -10px;
  right: -10px;
  background: orange;
  color: white;
  width: 20px;
  height: 20px;
  border-radius: 50%;
  text-align: center;
  line-height: 20px;
  font-size: 12px;
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  font-family: Arial, sans-serif;
}

body {
  background: #f5f5f5;
  padding: 09px;
}

.products {
  width: 100%;
}

#productBox {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 20px;
}

.card {
  background: #fff;
  border: 1px solid #ddd;
  border-radius: 10px;
  overflow: hidden;
  position: relative;
  transition: 0.3s;
}

.card:hover {
  box-shadow: 0 0 15px rgba(0, 0, 0, 0.2);
  transform: translateY(-5px);
}

.image {
  position: relative;
  overflow: hidden;
}

.image img {
  width: 100%;
  height: 70%;
  object-fit: cover;
}

.tag {
  position: absolute;
  top: 10px;
  left: 10px;
  background: red;
  color: white;
  padding: 5px 10px;
  border-radius: 5px;
  font-size: 14px;
}

.icon {
  position: absolute;
  top: 10px;
  right: -50px;
  display: flex;
  flex-direction: column;
  gap: 10px;
  transition: 0.3s;
}

.card:hover .icon {
  right: 10px;
}

.icon i {
  width: 35px;
  height: 35px;
  background: white;
  border-radius: 50%;
  text-align: center;
  line-height: 35px;
  cursor: pointer;
  box-shadow: 0 0 5px gray;
}

.details {
  padding: 15px;
}

.category {
  color: gray;
  font-size: 14px;
}

.name {
  font-size: 18px;
  margin: 8px 0;
}

.star {
  color: orange;
  margin-bottom: 10px;
}

.price {
  font-size: 20px;
  color: #0d6efd;
  font-weight: bold;
}

.price del {
  color: gray;
  font-size: 15px;
  margin-left: 8px;
}

.stock {
  margin-top: 10px;
  color: green;
  font-weight: bold;
}

.cart {
  width: 100%;
  padding: 10px;
  background: #0d6efd;
  color: white;
  border: none;
  margin-top: 15px;
  cursor: pointer;
  display: none;
  border-radius: 5px;
}

.card:hover .cart {
  display: block;
}

.cart:disabled {
  background: gray;
  cursor: not-allowed;
}


*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Arial;
}

body{
    background:#f5f5f5;
}

.hero{
    width:90%;
    margin:auto;
    display:flex;
    justify-content:space-between;
    align-items:center;
    padding:60px 0;
}

.left{
    width:50%;
}

.left h4{
    color:red;
    margin-bottom:20px;
}

.left h1{
    font-size:65px;
    margin-bottom:25px;
}

.left p{
    font-size:24px;
    color:gray;
    margin-bottom:35px;
}

button{
    padding:15px 40px;
    border:none;
    background:#1653c8;
    color:white;
    font-size:20px;
    border-radius:30px;
    cursor:pointer;
}

button:hover{
    background:#0c3d9c;
}

.right{
    width:50%;
    text-align:center;
}

.right img{
    width:100%;
    max-width:700px;
}

@media(max-width:768px){

.hero{
    flex-direction:column;
    text-align:center;
}

.left{
    width:100%;
}

.right{
    width:100%;
    margin-top:40px;
}

.left h1{
    font-size:40px;
}

.left p{
    font-size:18px;
}

}